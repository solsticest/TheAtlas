{
  "name": "the-atlas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @atlas/shared && concurrently -n web,api \"npm run dev -w @atlas/web\" \"npm run dev -w @atlas/api\"",
    "build": "npm run build -w @atlas/shared && npm run build -w @atlas/api && npm run build -w @atlas/web",
    "typecheck": "npm run build -w @atlas/shared && npm run typecheck --workspaces --if-present",
    "test": "node tests/regression.cjs && node tests/main-folder.cjs && node --test tests/migration-audit.cjs",
    "test:legacy": "node tests/regression.cjs && node tests/main-folder.cjs",
    "audit:legacy": "node scripts/audit-legacy.cjs --dry-run",
    "test:migration": "node --test tests/migration-audit.cjs",
    "db:setup": "node scripts/db-setup.cjs",
    "db:generate": "node scripts/db-setup.cjs --generate-only",
    "db:validate": "node scripts/db-setup.cjs --validate-only",
    "import:atlas": "node scripts/import-legacy-atlas.cjs",
    "export:atlas": "node scripts/export-legacy-atlas.cjs",
    "test:database": "node --test tests/db-import.cjs",
    "test:api": "node --import tsx --test tests/api-viewer.cjs",
    "test:geometry": "node --import tsx --test tests/viewer-geometry.cjs",
    "admin:setup": "node scripts/setup-admin.cjs",
    "backup:atlas": "node --import tsx scripts/backup-atlas.cjs",
    "test:admin": "node --import tsx --test tests/admin-security.cjs",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.{ts,tsx}\"",
    "start": "node apps/api/dist/server.js",
    "test:production": "node --import tsx --test tests/production.cjs",
    "test:alignment": "node --import tsx --test tests/align-legacy.cjs",
    "test:layer-editor": "node --import tsx --test tests/layer-editor.cjs",
    "test:workspace-paths": "node --import tsx --test tests/workspace-paths.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "prisma": "6.19.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.0",
    "globals": "^16.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "^16.6.1"
  }
}
