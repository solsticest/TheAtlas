PORT=3001
# Relative to apps/api/prisma/schema.prisma; resolves to <repository>/storage/atlas.db.
DATABASE_URL="file:../../../storage/atlas.db"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Host for the Express listener (use reverse proxy and HTTPS in production)
HOST=127.0.0.1
# Optional paths for persistent storage
# ATLAS_ASSETS_DIR=
# ATLAS_BACKUP_DIR=
