generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// This document is a guard against accidental import over existing user edits.
model AtlasDocument {
  id           String   @id
  version      Int
  sourceSha256 String
  isModified   Boolean  @default(false)
  rootExtras   String
  importedAt   DateTime @default(now())
}

model MarkerType {
  id        String     @id
  name      String
  symbol    String
  color     String     @default("#d6b77a")
  iconSvg   String?
  sortOrder Int        @unique
  raw       String
  locations Location[]
}

model World {
  id         String     @id
  name       String
  image      String?
  width      Float
  height     Float
  kmPerPixel Float?
  sortOrder  Int        @unique
  raw        String
  layers     MapLayer[]
  locations  Location[]
  timelines   Timeline[]
}

model MapLayer {
  id         String     @id
  worldId    String
  parentId   String?
  name       String
  image      String?
  width      Float
  height     Float
  bounds     String
  rotation   Float
  showAtZoom Float
  fadeRange  Float
  enabled    Boolean
  sortOrder  Int
  raw        String

  world      World       @relation(fields: [worldId], references: [id], onDelete: Restrict)
  parent     MapLayer?   @relation("LayerHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   MapLayer[]  @relation("LayerHierarchy")

  @@unique([worldId, sortOrder])
  @@index([worldId, parentId])
}

model Location {
  id          String      @id
  worldId     String
  typeId      String
  name        String
  x           Float
  y           Float
  color       String
  minZoom     Float
  description String
  article     String?
  tags        String
  sortOrder   Int
  raw         String

  world       World      @relation(fields: [worldId], references: [id], onDelete: Restrict)
  markerType  MarkerType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  events      Event[]

  @@unique([worldId, sortOrder])
  @@index([worldId, typeId])
}

model MediaAsset {
  path       String   @id
  filename   String
  kind       String
  bytes      Int
  sha256     String
  width      Int?
  height     Int?
  storedPath String
  importedAt DateTime @default(now())
}

model Timeline {
  id          String   @id
  worldId     String
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  isDefault   Boolean  @default(false)
  status      String   @default("draft")
  world       World    @relation(fields: [worldId], references: [id], onDelete: Restrict)
  eras        Era[]
  @@index([worldId, sortOrder])
}

model Era {
  id          String   @id
  timelineId  String
  name        String
  description String   @default("")
  dateLabel   String   @default("")
  sortOrder   Int      @default(0)
  image       String?
  timeline    Timeline @relation(fields: [timelineId], references: [id], onDelete: Restrict)
  events      Event[]
  @@index([timelineId, sortOrder])
}

model Event {
  id         String   @id
  eraId      String
  title      String
  summary    String   @default("")
  article    String   @default("")
  type       String   @default("")
  tags       String   @default("[]")
  dateLabel  String   @default("")
  sortOrder  Int      @default(0)
  locationId String?
  x          Float?
  y          Float?
  image      String?
  status     String   @default("draft")
  era        Era      @relation(fields: [eraId], references: [id], onDelete: Restrict)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  @@index([eraId, status, sortOrder])
}

model AdminSession {
  idHash    String   @id
  csrfHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model EditHistory {
  id         Int      @id @default(autoincrement())
  entityKind String
  entityId   String
  action     String
  beforeJson String?
  afterJson  String?
  applied    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([applied, id])
}
